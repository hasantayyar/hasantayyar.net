---
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ "/feed/" | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ "/about/" | absolute_url }}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.7</priority>
  </url>
  {% assign all_categories = site.posts | map: 'categories' | flatten | uniq | sort %}
  {% for category in all_categories %}
  {% capture category_path %}/feed/category/{{ category | slugify }}/{% endcapture %}
  <url>
    <loc>{{ category_path | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | prepend: site.baseurl | prepend: site.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
</urlset>
